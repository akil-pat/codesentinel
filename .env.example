# Copy to .env and fill in. Never commit the real .env file.

# Anthropic API key for the review agent.
ANTHROPIC_API_KEY=

# Model override. Defaults to claude-opus-5 if unset.
CODESENTINEL_MODEL=claude-opus-5

# --- FastAPI webhook service ---

# Secret configured on the GitHub webhook, used to verify the
# X-Hub-Signature-256 header on incoming requests. Required in production.
GITHUB_WEBHOOK_SECRET=

# Token used to post review comments back to the PR (repo:status / pull
# request write scope). A fine-grained PAT scoped to this repo only, or a
# GitHub App installation token.
GITHUB_TOKEN=
